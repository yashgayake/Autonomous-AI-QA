rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocumentOwner() {
      return isSignedIn() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    // Users Collection: Users can read and write only their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Test Runs: Signed-in users can read, creators can write
    match /test_runs/{runId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Bug Reports: Signed-in users can read, creators can create and update
    match /bug_reports/{bugId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Playwright Test Suites: Signed-in users can read, creators can write
    match /test_suites/{suiteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Connection validation test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
